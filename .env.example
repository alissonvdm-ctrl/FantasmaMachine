# Banco libSQL (Turso em produção). Em dev/local pode ser um arquivo:
#   DATABASE_URL=file:./data/app.db
# Em produção (Vercel + Turso):
#   DATABASE_URL=libsql://<seu-banco>.turso.io
DATABASE_URL=file:./data/app.db

# Token de autenticação do Turso (obrigatório em produção; vazio localmente)
DATABASE_AUTH_TOKEN=

# Segredo que autoriza POST/GET em /api/cron/sync (header Authorization: Bearer <valor>)
# Em produção na Vercel, nomeie a env var exatamente CRON_SECRET: a própria
# Vercel Cron envia esse header automaticamente quando o nome bate.
CRON_SECRET=

# Host autorizado no ReadOnly Guard (nunca aponte para outro domínio)
VENDPAGO_HOST=www.erpvending.com.br

# Credenciais de leitura do VendPago (obrigatórias para a sincronização)
VENDPAGO_USER=
# Senha cifrada em AES-256-GCM (nunca a senha em texto puro)
VENDPAGO_PASSWORD_ENC=

# Chave usada para cifrar/decifrar VENDPAGO_PASSWORD_ENC (32 bytes, base64)
ENCRYPTION_KEY=

# Hash Argon2 da senha de administração
ADMIN_PASSWORD_HASH=

# Segredo de assinatura do cookie de sessão admin
SESSION_SECRET=

# Timeout de navegação do Playwright, em milissegundos
PLAYWRIGHT_TIMEOUT_MS=45000

# Nível de log estruturado: debug | info | warn | error
LOG_LEVEL=info
